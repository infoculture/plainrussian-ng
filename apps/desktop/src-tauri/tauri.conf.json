{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PlainRussian",
  "version": "0.1.0",
  "identifier": "ru.plainrussian.desktop",
  "build": {
    "frontendDist": "../../web/dist-desktop",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../web run dev:desktop",
    "beforeBuildCommand": "npm --prefix ../web run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Простой русский",
        "width": 1200,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self'",
        "img-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.anthropic.com",
        "worker-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Оценка простоты русскоязычных текстов",
    "longDescription": "Оценивает, насколько просто читать текст на русском языке. Текст обрабатывается на компьютере и никуда не отправляется, если не включить оценку с помощью LLM.",
    "copyright": "Информационная культура",
    "macOS": {
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
