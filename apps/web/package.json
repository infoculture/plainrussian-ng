{
  "name": "plainrussian-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "sh scripts/build-wasm.sh",
    "dev": "npm run wasm && vite",
    "build": "npm run wasm && svelte-check && vite build",
    "preview": "vite preview",
    "check": "svelte-check",
    "dev:desktop": "npm run wasm && vite --mode desktop --port 5173 --strictPort",
    "build:desktop": "npm run wasm && svelte-check && vite build --mode desktop"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.8",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@mozilla/readability": "^0.6.0",
    "@tauri-apps/api": "^2.12.4",
    "mammoth": "^1.13.0",
    "pdfjs-dist": "^6.4.299",
    "zod": "^4.6.7"
  }
}
